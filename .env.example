# DeepSeek API Key
# Copy this file to .env and fill in your actual key
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# LibreDWG path (optional, for DWG→DXF conversion)
LIBREDWG_PATH=D:\Code\libredwg-0.13.4.8160-win64

# FreeCAD binary path (optional, auto-detected on most systems)
FREECAD_BIN_PATH=D:\FreeCAD 1.0\bin
